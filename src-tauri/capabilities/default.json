{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "crozzo-whatsapp-dock"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-crozzo-external",
    "process:default",
    "allow-crozzo-list-printers",
    "allow-crozzo-get-default-printer",
    "allow-crozzo-print-raw",
    "allow-crozzo-http",
    "allow-crozzo-install",
    "allow-crozzo-dian",
    "allow-crozzo-lan-sync",
    "allow-crozzo-gossip-udp",
    "allow-crozzo-ble-mesh",
    "allow-crozzo-lan-ws",
    "allow-crozzo-mdns",
    "allow-crozzo-webview-camera",
    "allow-crozzo-devtools"
  ]
}
