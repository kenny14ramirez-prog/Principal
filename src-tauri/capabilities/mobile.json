{
  "identifier": "mobile-capability",
  "description": "Permisos app Android / tablet",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "process:default",
    "allow-crozzo-http",
