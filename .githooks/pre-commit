#!/bin/sh
# Pre-commit hook — conectividad del arsenal (Crozzo POS)
# Activar: git config core.hooksPath .githooks

echo "=== Army pre-commit checks ==="

# 1. Verificar integridad del ejército
node scripts/verify-army.mjs || exit 1

# 2. Validar known issues
npm run issues:validate || exit 1

# 3. Verificar mapas frescos (advertencia, no bloquea)
node scripts/check-maps-fresh.mjs || echo "WARNING: mapas desactualizados — ejecuta npm run map:refresh"

echo "=== Army pre-commit OK ==="
